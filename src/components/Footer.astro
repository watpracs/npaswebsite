---
const year = new Date().getFullYear();
---

<footer class="bg-neutral-950 text-neutral-300 border-t border-neutral-800">
  <!-- Affiliation strip -->
  <div class="border-b border-neutral-900 py-8 bg-neutral-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-around gap-6 opacity-80 hover:opacity-100 transition-opacity">
        <div class="flex items-center gap-3">
          <img src="/assets/images/logos/FIAP.jpg" alt="FIAP Logo" class="h-12 w-auto object-contain rounded" />
          <div class="text-xs">
            <span class="block font-bold text-white uppercase tracking-wider">FIAP</span>
            <span class="text-neutral-400">Operational Member for Sri Lanka</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <img src="/assets/images/logos/PSA.jpeg" alt="PSA Logo" class="h-12 w-auto object-contain rounded" />
          <div class="text-xs">
            <span class="block font-bold text-white uppercase tracking-wider">PSA</span>
            <span class="text-neutral-400">Photographic Society of America</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <img src="/assets/images/logos/GPU.jpg" alt="GPU Logo" class="h-12 w-auto object-contain rounded" />
          <div class="text-xs">
            <span class="block font-bold text-white uppercase tracking-wider">GPU</span>
            <span class="text-neutral-400">World Photography Center Sri Lanka</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Col 1: About NPAS -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/assets/images/logos/NPAS-Official-Logo.png"
            alt="NPAS Logo"
            class="h-10 w-auto object-contain"
          />
          <h3 class="text-lg font-bold text-white tracking-wide">
            NPAS SRI LANKA
          </h3>
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed">
          The National Photographic Art Society of Sri Lanka was established in 1950 by the late Mr. Wilson Hegoda. As the authorized FIAP operational member, NPAS leads photographic education, distinctions, and national/international exhibitions in Sri Lanka.
        </p>
        <p class="text-xs text-amber-500/80 font-medium">
          Registered Charity & Limited Liability Body under the Laws of Sri Lanka.
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider">Explore</h4>
        <ul class="space-y-2 text-xs text-neutral-400">
          <li><a href="/about-us" class="hover:text-amber-400 transition-colors">About Society & History</a></li>
          <li><a href="/about-us#board" class="hover:text-amber-400 transition-colors">Board of Directors 2025–2026</a></li>
          <li><a href="/exhibitions" class="hover:text-amber-400 transition-colors">National & International Exhibitions</a></li>
          <li><a href="/education" class="hover:text-amber-400 transition-colors">Diploma in Photography</a></li>
          <li><a href="/distinctions" class="hover:text-amber-400 transition-colors">FIAP & NPAS Distinctions</a></li>
          <li><a href="/membership" class="hover:text-amber-400 transition-colors">Become a Member / Life Membership</a></li>
        </ul>
      </div>

      <!-- Col 3: Competitions & Exhibitions -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider">Exhibitions & Salons</h4>
        <ul class="space-y-2 text-xs text-neutral-400">
          <li><a href="/exhibitions" class="hover:text-amber-400 transition-colors">46th National Exhibition 2026</a></li>
          <li><a href="/exhibitions" class="hover:text-amber-400 transition-colors">21st International Salon 2025</a></li>
          <li><a href="/assets/docs/exhibitions/46th_NPAS_Competition_Exhibition_2026_Guidelines_English.pdf" target="_blank" class="hover:text-amber-400 transition-colors">Download Guidelines (PDF)</a></li>
          <li><a href="/assets/docs/exhibitions/CATALOGUE-NPAS-45TH-NATIONAL-EXHIBITION-OF-PHOTOGRAPHY-2024.pdf" target="_blank" class="hover:text-amber-400 transition-colors">Annual Catalogues</a></li>
          <li><a href="/publication" class="hover:text-amber-400 transition-colors">NPAS Journal & Periodicals</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Secretariat -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider">Secretariat</h4>
        <div class="space-y-2 text-xs text-neutral-400">
          <p class="leading-relaxed">
            <strong class="text-neutral-200">The National Photographic Art Society</strong><br/>
            82C, Sri Sudarshanarama Road,<br/>
            Kiribathgoda. 11600, Sri Lanka.
          </p>
          <p>
            <strong class="text-neutral-200">Director Registrar:</strong><br/>
            <a href="tel:+94713963030" class="hover:text-amber-400">+94 71 396 3030</a>
          </p>
          <p>
            <strong class="text-neutral-200">Official Emails:</strong><br/>
            <a href="mailto:npas@sltnet.lk" class="block hover:text-amber-400">npas@sltnet.lk</a>
            <a href="mailto:npassrilanka@gmail.com" class="block hover:text-amber-400">npassrilanka@gmail.com</a>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-neutral-900 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
      <p>© {year} The National Photographic Art Society of Sri Lanka. All Rights Reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/contact-us" class="hover:text-neutral-300">Privacy & Terms</a>
        <a href="/contact-us" class="hover:text-neutral-300">Contact Support</a>
        <a href="https://npassrilanka.org" class="text-amber-500/80 hover:text-amber-400 font-medium">npassrilanka.org</a>
      </div>
    </div>
  </div>
</footer>
