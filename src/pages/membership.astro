---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Membership"
  description="Become a Member or Life Member of the National Photographic Art Society of Sri Lanka. Enjoy workshops, national salon discounts, distinctions eligibility, and fraternity benefits."
>
  <!-- Page Header -->
  <section class="bg-neutral-900/60 border-b border-neutral-800 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Join Our Fraternity</span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">Society Membership</h1>
      <p class="max-w-2xl mx-auto text-neutral-400 text-sm sm:text-base leading-relaxed px-4">
        Connect with over seven decades of photographic tradition, elevate your skills, and earn international recognition.
      </p>
    </div>
  </section>

  <!-- Membership Types Grid -->
  <section class="py-16 sm:py-24 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Ordinary / Annual Membership Card -->
        <div class="rounded-3xl bg-neutral-900 border border-neutral-800 p-8 sm:p-12 space-y-8 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-xl">
          <div class="space-y-6">
            <div class="inline-block px-3 py-1 rounded bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-wider">
              General Membership
            </div>
            
            <div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Ordinary / Associate Member</h2>
              <p class="text-neutral-400 text-xs sm:text-sm mt-2">
                Offered annually to successful applicants interested in expanding their photographic horizons.
              </p>
            </div>

            <div class="space-y-3 pt-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200">Key Membership Privileges:</h3>
              <ul class="space-y-2.5 text-xs text-neutral-300">
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">✓</span> Free or discounted admission to workshops, webinars, and field excursions
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">✓</span> Eligibility to participate in monthly internal competitions
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">✓</span> Concessionary entry fees for the Annual National & International Salons
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">✓</span> Eligibility to apply for NPAS and FIAP photographic distinctions
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">✓</span> Receipt of official society publications and digital journals
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 space-y-3">
            <a
              href="mailto:Saliyaliyanage79@gmail.com?subject=NPAS Ordinary Membership Application"
              class="block w-full py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider text-center transition-all shadow-md"
            >
              Apply Online via Registrar &rarr;
            </a>
            <p class="text-[11px] text-center text-neutral-500">
              Registrar Contact: +94 713 963 030 (Saliya Liyanage)
            </p>
          </div>
        </div>

        <!-- Life Membership Card -->
        <div class="rounded-3xl bg-neutral-900 border border-neutral-800 p-8 sm:p-12 space-y-8 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-xl relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl"></div>

          <div class="space-y-6 relative">
            <div class="inline-block px-3 py-1 rounded bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider">
              Prestigious Status
            </div>

            <div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Life Membership</h2>
              <p class="text-neutral-400 text-xs sm:text-sm mt-2">
                "Your Pride of Life — For Life": A permanent commitment to the photographic arts in Sri Lanka.
              </p>
            </div>

            <div class="space-y-3 pt-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-200">Life Member Privileges:</h3>
              <ul class="space-y-2.5 text-xs text-neutral-300">
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">★</span> Lifetime voting rights at the Annual General Meeting (AGM)
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">★</span> Exemption from recurring annual membership renewal subscriptions
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">★</span> Official Life Member certificate and institutional lapel badge
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">★</span> Priority invitation to VIP jury sessions and national exhibition galas
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">★</span> Eligibility to be elected to the Board of Directors
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 space-y-3 relative">
            <a
              href="mailto:Saliyaliyanage79@gmail.com?subject=Life Membership Request"
              class="block w-full py-3.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-white font-bold text-xs uppercase tracking-wider text-center border border-neutral-700 hover:border-amber-500/50 transition-all shadow-md"
            >
              Request Life Membership &rarr;
            </a>
            <p class="text-[11px] text-center text-amber-400/80">
              Applications reviewed semi-annually by the Executive Directorate.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
