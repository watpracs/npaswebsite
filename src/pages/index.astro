---
import BaseLayout from '../layouts/BaseLayout.astro';
import { exhibitionsData } from '../data/exhibitions';

const latestExhibition = exhibitionsData[0];
const intlExhibition = exhibitionsData[1];

// Curated master award-winning photographs that rotate smoothly in the hero background
const heroSlides = [
  {
    image: "/assets/images/exhibitions/NPAS-Gold-Medal-elmas-Cumcu-Turkiye-isolation-1-scaled.jpg",
    title: "Isolation",
    photographer: "Elmas Cumcu",
    country: "Türkiye",
    award: "NPAS Gold Medal • 21st International Salon"
  },
  {
    image: "/assets/images/exhibitions/FIAP-Silver-Medal-WASIRI-GAJAMAN-Sri-Lanka-BATTLE-1-scaled.jpg",
    title: "Battle",
    photographer: "Dr. Wasiri Gajaman",
    country: "Sri Lanka",
    award: "FIAP Silver Medal • 46th National Competition"
  },
  {
    image: "/assets/images/exhibitions/NPAS-Gold-Medal-Erdem-Arif-Yigit-Turkiye-gokhan_usta_2742-1-scaled.jpg",
    title: "Gokhan Usta",
    photographer: "Erdem Arif Yigit",
    country: "Türkiye",
    award: "NPAS Gold Medal • 21st International Salon"
  },
  {
    image: "/assets/images/exhibitions/NPAS-Silver-Medal-Pandula-Bandara-Sri-Lanka-Check-Mate-1-scaled.jpg",
    title: "Check Mate",
    photographer: "Pandula Bandara",
    country: "Sri Lanka",
    award: "NPAS Silver Medal • 46th National Competition"
  },
  {
    image: "/assets/images/exhibitions/NPAS-Ribbon-Rowshan-Akhter-USA-Subah-E-Benaras-6454-1-scaled.jpg",
    title: "Subah-E-Benaras",
    photographer: "Rowshan Akhter",
    country: "USA",
    award: "NPAS Ribbon • 21st International Salon"
  }
];
---

<BaseLayout title="Home - The National Photographic Art Society of Sri Lanka">
  
  <!-- Hero Section (More compact & well-fitted viewport height: ~540px to 600px instead of huge 700px) -->
  <section id="hero-slider" class="relative bg-neutral-950 overflow-hidden border-b border-neutral-800 min-h-[500px] sm:min-h-[560px] lg:min-h-[600px] flex items-center">
    
    <!-- Background Slides with Smooth Opacity Cross-fade -->
    <div class="absolute inset-0 z-0">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
          data-slide-index={index}
        >
          <img
            src={slide.image}
            alt={`${slide.title} by ${slide.photographer}`}
            class="w-full h-full object-cover object-center"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/80 to-neutral-950/45"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/75 to-transparent"></div>
        </div>
      ))}
    </div>

    <!-- Main Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 w-full">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 sm:gap-12">
        
        <!-- Left: Headings and Action buttons -->
        <div class="max-w-2xl space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            Established 1950 • Operational Member of FIAP
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
            Inspiring the Art of <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">Photography</span> in Sri Lanka
          </h1>

          <p class="text-sm sm:text-base lg:text-lg text-neutral-300 leading-relaxed font-light max-w-xl">
            The National Photographic Art Society of Sri Lanka is the nation's premier body fostering photographic mastery, professional distinctions, diplomas, and international exhibitions for over seven decades.
          </p>

          <!-- Buttons ordered: Membership > Education > Exhibitions > Distinctions -->
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-1">
            <a
              href="/membership"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs sm:text-sm tracking-wide transition-all shadow-lg shadow-amber-500/20 hover:shadow-amber-500/30 flex items-center gap-2"
            >
              Become a Member
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a
              href="/education"
              class="px-5 py-3 rounded-xl bg-neutral-900/90 hover:bg-neutral-800 text-neutral-100 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 hover:border-neutral-500 transition-all backdrop-blur-md"
            >
              Diploma Courses
            </a>
            <a
              href="/exhibitions"
              class="px-5 py-3 rounded-xl bg-neutral-900/90 hover:bg-neutral-800 text-amber-400 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 transition-all backdrop-blur-md"
            >
              Exhibitions & Salons
            </a>
            <a
              href="/distinctions"
              class="px-4 py-3 rounded-xl bg-transparent hover:bg-neutral-900/60 text-neutral-300 hover:text-amber-400 font-semibold text-xs sm:text-sm tracking-wide transition-all"
            >
              Distinctions &rarr;
            </a>
          </div>
        </div>

        <!-- Right: Discreet, Subtle Translucent Attribution Badge (Less intrusive, highly subtle) -->
        <div class="flex-shrink-0">
          <div class="inline-flex items-center gap-3 px-3.5 py-2 rounded-xl bg-neutral-950/60 backdrop-blur-sm border border-neutral-800/60 shadow-lg text-left">
            <div class="w-1.5 h-1.5 rounded-full bg-amber-400/80"></div>
            <div class="text-[11px] leading-tight">
              <span id="slide-title" class="font-semibold text-neutral-200">
                "{heroSlides[0].title}"
              </span>
              <span id="slide-author" class="text-neutral-400 font-normal ml-1">
                — {heroSlides[0].photographer} ({heroSlides[0].country})
              </span>
            </div>
            <span id="slide-counter" class="text-neutral-500 text-[10px] font-mono pl-2 border-l border-neutral-800">
              1/{heroSlides.length}
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Key Pillars / Feature Cards (Luxury Architectural Look with Hover Glow and Floating Animation) -->
  <section class="py-20 sm:py-24 bg-neutral-950 border-b border-neutral-800 relative overflow-hidden">
    <!-- Ambient radial glow behind pillars -->
    <div class="absolute inset-0 bg-radial-vignette pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="inline-block px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-widest">
          Foundational Heritage
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
          Dedicated to <span class="gold-shimmer-text">Photographic Excellence</span>
        </h2>
        <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
          The four cornerstone pillars elevating photographic art across Sri Lanka since 1950.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <!-- Pillar 01: Membership -->
        <div class="p-8 rounded-2xl glass-panel hover:border-amber-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/10 group flex flex-col justify-between">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400/90 tracking-widest px-2.5 py-1 rounded-md bg-amber-400/10 border border-amber-400/20">01</span>
              <div class="w-11 h-11 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Membership
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                Join a respected national fraternity with access to masterclasses, monthly competitions, voting rights, and permanent Life Membership status.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 mt-6">
            <a href="/membership" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
              Join Fraternity <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 02: Education -->
        <div class="p-8 rounded-2xl glass-panel hover:border-amber-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/10 group flex flex-col justify-between">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400/90 tracking-widest px-2.5 py-1 rounded-md bg-amber-400/10 border border-amber-400/20">02</span>
              <div class="w-11 h-11 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Education
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                Esteemed academic Diploma in Photography and free island-wide school photography examinations fostering the next generation of visual artists.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 mt-6">
            <a href="/education" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
              Explore Courses <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 03: Exhibitions -->
        <div class="p-8 rounded-2xl glass-panel hover:border-amber-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/10 group flex flex-col justify-between">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400/90 tracking-widest px-2.5 py-1 rounded-md bg-amber-400/10 border border-amber-400/20">03</span>
              <div class="w-11 h-11 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Exhibitions
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                Annual National Exhibitions and FIAP Patronage International Salons recognizing world-class creations with medals, ribbons, and printed catalogues.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 mt-6">
            <a href="/exhibitions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
              View Salons & Results <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 04: Distinctions -->
        <div class="p-8 rounded-2xl glass-panel hover:border-amber-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/10 group flex flex-col justify-between">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400/90 tracking-widest px-2.5 py-1 rounded-md bg-amber-400/10 border border-amber-400/20">04</span>
              <div class="w-11 h-11 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 group-hover:scale-110 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Distinctions
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                Apply online for prestigious national NPAS distinctions (LNPAS, ANPAS, FNPAS) and global FIAP Honors (AFIAP, EFIAP, MFIAP).
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800 mt-6">
            <a href="/distinctions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
              Apply For Distinctions <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Special Heritage Spotlight: Welcome & The Iconic Henry Rajakaruna Masterpiece (Fully Displayed, No Strips) -->
  <section class="py-20 sm:py-24 bg-neutral-900/40 border-b border-neutral-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        
        <!-- Left: Society Heritage & Wilson Hegoda Legacy -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            Heritage & Mission
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Welcome to The National Photographic Art Society of Sri Lanka
          </h2>

          <div class="space-y-4 text-xs sm:text-sm text-neutral-300 font-light leading-relaxed">
            <p>
              The National Photographic Art Society of Sri Lanka was formed in the year 1950, just two years after gaining independence from the British Empire. From its very inception, it originated as a national cultural movement aimed at educating local enthusiasts in the art and craft of photography.
            </p>
            <p>
              A brainchild of the late pioneer <span class="text-white font-medium">Mr. Wilson Hegoda</span>, the society initially catered to local communities across Sri Lanka by conducting classes leading to a recognized diploma — offered free of charge to members and school students as a national community initiative.
            </p>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a
              href="/about-us"
              class="px-6 py-3 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-100 font-semibold text-xs border border-neutral-700 hover:border-amber-500/50 transition-all shadow-md flex items-center gap-2"
            >
              <span>Our 75-Year History</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/membership"
              class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
            >
              Join Our Movement
            </a>
          </div>
        </div>

        <!-- Right: The Complete Iconic Masterpiece by Henry Rajakaruna (Uncropped, Premium Frame) -->
        <div class="lg:col-span-6">
          <div class="relative group">
            <!-- Ambient Golden Glow behind frame -->
            <div class="absolute -inset-1 bg-gradient-to-r from-amber-500/20 via-neutral-700/20 to-amber-500/10 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>

            <div class="relative rounded-2xl bg-neutral-950 border border-neutral-800 overflow-hidden shadow-2xl p-3 sm:p-4">
              <!-- Image container with natural aspect ratio so NO strips or cutoffs occur -->
              <div class="relative overflow-hidden rounded-xl bg-black">
                <img
                  src="/assets/images/history/henry-rajakaruna-masterpiece.jpg"
                  alt="Photograph by Henry Rajakaruna - Village Morning Light"
                  class="w-full h-auto max-h-[460px] object-contain mx-auto transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>

              <!-- Refined Master Attribution Plaque -->
              <div class="mt-3.5 px-3 py-2.5 rounded-xl bg-neutral-900/90 border border-neutral-800/80 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                  <div>
                    <span class="text-xs font-semibold text-white tracking-wide block">
                      Photograph by Henry Rajakaruna
                    </span>
                    <span class="text-[11px] text-neutral-400">
                      Honorary Life Member & Master Fellow • NPAS Permanent Archives
                    </span>
                  </div>
                </div>
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-1 rounded bg-amber-400/10 text-amber-400 border border-amber-400/20 hidden sm:inline-block">
                  Master Collection
                </span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 1. Membership Spotlight Area -->
  <section class="py-16 sm:py-24 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl glass-panel-gold p-8 sm:p-14 flex flex-col lg:flex-row items-center justify-between gap-8 shadow-2xl relative overflow-hidden">
        <div class="space-y-4 max-w-2xl relative z-10">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Fraternity of Excellence</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white">Your Pride of Life — For Life</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            Whether taking your first steps into artistic photography or applying for permanent Life Membership status, NPAS connects you to seven decades of collective photographic wisdom, monthly salons, and world affiliations.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 flex-shrink-0 relative z-10">
          <a
            href="/membership"
            class="px-8 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-xl shadow-amber-500/20 hover:scale-105"
          >
            Apply For Membership &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Education Spotlight Area -->
  <section class="py-16 sm:py-24 bg-neutral-900/30 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-5">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Academic Studies</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white">Comprehensive Diploma in Photography</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            Providing high-caliber photographic training from optical physics and studio lighting to advanced digital darkroom techniques and critique. Guided by the Director of Education and veteran faculty.
          </p>
          <div class="pt-2 flex gap-4">
            <a
              href="/education"
              class="px-6 py-3.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white font-semibold text-xs transition-all border border-neutral-700 hover:border-amber-400 flex items-center gap-2"
            >
              <span>Explore Course Syllabus</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-neutral-800 shadow-2xl group relative">
          <img
            src="/assets/images/education/edu-dip.jpg"
            alt="Diploma in Photography"
            class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 p-3 rounded-lg bg-neutral-950/80 backdrop-blur-sm border border-neutral-800 text-xs text-neutral-300">
            🎓 Annual Graduation & Island-wide School Photography Examination
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Exhibitions & Awards Showcase (Fixed 46th Poster with Results Banner) -->
  <section class="py-16 sm:py-24 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
