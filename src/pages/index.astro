---
import BaseLayout from '../layouts/BaseLayout.astro';
import { exhibitionsData } from '../data/exhibitions';

const latestExhibition = exhibitionsData[0];
const intlExhibition = exhibitionsData[1];
---

<BaseLayout title="Home - National Photographic Art Society of Sri Lanka">
  
  <!-- Hero Section -->
  <section class="relative bg-neutral-950 overflow-hidden border-b border-neutral-800">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/images/hero/new_home_hero_banner.jpg"
        alt="NPAS Master Photographic Art"
        class="w-full h-full object-cover object-center opacity-30 transform scale-105 transition-transform duration-1000 ease-out"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32 lg:py-40">
      <div class="max-w-3xl space-y-8">
        
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Established 1950 • Operational Member of FIAP
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Inspiring the Art of <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">Photography</span> in Sri Lanka
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-neutral-300 leading-relaxed font-light">
          The National Photographic Art Society of Sri Lanka is the premier institution fostering photographic mastery, professional distinctions, recognized diplomas, and world-class exhibitions for over seven decades.
        </p>

        <!-- CTA Buttons ordered: Membership > Education > Exhibitions > Distinctions -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
          <a
            href="/membership"
            class="px-6 py-3.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs sm:text-sm tracking-wide transition-all shadow-lg shadow-amber-500/20 hover:shadow-amber-500/30 flex items-center gap-2"
          >
            Become a Member
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/education"
            class="px-6 py-3.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 text-neutral-100 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 hover:border-neutral-500 transition-all"
          >
            Diploma Courses
          </a>
          <a
            href="/exhibitions"
            class="px-6 py-3.5 rounded-lg bg-neutral-900/80 hover:bg-neutral-800 text-amber-400 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 transition-all"
          >
            Exhibitions & Salons
          </a>
          <a
            href="/distinctions"
            class="px-6 py-3.5 rounded-lg bg-transparent hover:bg-neutral-900 text-neutral-300 hover:text-amber-400 font-semibold text-xs sm:text-sm tracking-wide transition-all"
          >
            Distinctions &rarr;
          </a>
        </div>

        <!-- Master Photographer credit -->
        <p class="text-xs text-neutral-500 italic">
          Master photography by Henry Rajakaruna & acclaimed NPAS fellows.
        </p>

      </div>
    </div>
  </section>

  <!-- Key Pillars / Feature Cards (Ordered strictly: Membership > Education > Exhibitions > Distinctions) -->
  <section class="py-16 sm:py-20 bg-neutral-900/60 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
        <h2 class="text-xs uppercase tracking-widest text-amber-400 font-bold">Key Pillars</h2>
        <p class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Dedicated to Photographic Excellence</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <!-- 1. Membership -->
        <div class="p-6 sm:p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-amber-500/40 transition-all hover:-translate-y-1 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-neutral-950 transition-colors">
              👥
            </div>
            <h3 class="text-xl font-bold text-white mb-3">1. Membership</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-6">
              Join a prestigious fraternity of photographic artists with exclusive access to masterclasses, competitions, and Life Membership privileges.
            </p>
          </div>
          <a href="/membership" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1">
            Join Today &rarr;
          </a>
        </div>

        <!-- 2. Education -->
        <div class="p-6 sm:p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-amber-500/40 transition-all hover:-translate-y-1 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-neutral-950 transition-colors">
              🎓
            </div>
            <h3 class="text-xl font-bold text-white mb-3">2. Education</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-6">
              Our esteemed Diploma in Photography and free island-wide school examinations fostering young emerging talent across Sri Lanka.
            </p>
          </div>
          <a href="/education" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1">
            Explore Courses &rarr;
          </a>
        </div>

        <!-- 3. Exhibitions -->
        <div class="p-6 sm:p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-amber-500/40 transition-all hover:-translate-y-1 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-neutral-950 transition-colors">
              🏛️
            </div>
            <h3 class="text-xl font-bold text-white mb-3">3. Exhibitions</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-6">
              Annual National & FIAP International Exhibitions inviting submissions from photographers across Sri Lanka and 50+ countries worldwide.
            </p>
          </div>
          <a href="/exhibitions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1">
            View Salons & Results &rarr;
          </a>
        </div>

        <!-- 4. Distinctions -->
        <div class="p-6 sm:p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-amber-500/40 transition-all hover:-translate-y-1 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-neutral-950 transition-colors">
              🎖️
            </div>
            <h3 class="text-xl font-bold text-white mb-3">4. Distinctions</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-6">
              Official FIAP Honors (AFIAP, EFIAP, MFIAP) and prestigious NPAS Honors (LNPAS, ANPAS, FNPAS) recognizing photographic artistry.
            </p>
          </div>
          <a href="/distinctions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1">
            Apply For Distinctions &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 1. Membership Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-neutral-900 border border-neutral-800 p-8 sm:p-12 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-4 max-w-2xl">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Fraternity</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Your Pride of Life — For Life</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
            Whether taking your first steps or seeking permanent Life Membership, NPAS offers unmatched fraternity support, monthly internal contests, and salon fee concessions.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 flex-shrink-0">
          <a
            href="/membership"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            Apply For Membership &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Education Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-900/40 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="space-y-4">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Academic Studies</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Comprehensive Diploma in Photography</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            Providing high-caliber photographic training from optics and studio lighting to advanced digital darkroom techniques. Guided by the Director of Education and veteran faculty.
          </p>
          <div class="pt-2 flex gap-4">
            <a
              href="/education"
              class="px-5 py-3 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white font-semibold text-xs transition-colors border border-neutral-700"
            >
              Explore Course Details &rarr;
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-neutral-800 shadow-xl max-h-72">
          <img
            src="/assets/images/education/edu-dip.jpg"
            alt="Diploma in Photography"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Exhibitions & Awards Showcase -->
  <section class="py-16 sm:py-20 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Competitions & Salons</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Exhibitions & Medal Winners</h2>
        </div>
        <a href="/exhibitions" class="inline-flex items-center text-xs sm:text-sm font-semibold text-amber-400 hover:text-amber-300">
          All Exhibitions & Guidelines &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Big Card: 46th National Exhibition -->
        <div class="lg:col-span-2 rounded-2xl bg-neutral-900 border border-neutral-800 overflow-hidden flex flex-col md:flex-row">
          <div class="md:w-1/2 relative min-h-[260px]">
            <img
              src={latestExhibition.coverImage}
              alt={latestExhibition.title}
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="md:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center gap-2">
                <span class="inline-block px-2.5 py-1 rounded bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider">
                  {latestExhibition.type}
                </span>
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider border border-emerald-500/30">
                  Results Published
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
                {latestExhibition.title}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
                {latestExhibition.description}
              </p>
            </div>
            
            <div class="pt-6 space-y-3">
              <div class="flex flex-wrap gap-2.5">
                <a
                  href={latestExhibition.resultsPdf}
                  target="_blank"
                  class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-xs font-bold text-white transition-colors flex items-center gap-1.5"
                >
                  🏆 View Results (PDF)
                </a>
                <a
                  href={latestExhibition.guidelinesEnglishPdf}
                  target="_blank"
                  class="px-3.5 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-xs font-semibold text-neutral-200 transition-colors"
                >
                  📄 Guidelines
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 21st International Salon Card -->
        <div class="rounded-2xl bg-neutral-900 border border-neutral-800 overflow-hidden flex flex-col justify-between p-6 sm:p-8">
          <div class="space-y-4">
            <span class="inline-block px-2.5 py-1 rounded bg-sky-500/20 text-sky-400 text-xs font-bold uppercase tracking-wider">
              {intlExhibition.type} Salon
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
              {intlExhibition.title}
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {intlExhibition.description}
            </p>
            <div class="rounded-xl overflow-hidden border border-neutral-800 my-2">
              <img
                src={intlExhibition.featuredWinners?.[0]?.image}
                alt="Award Winner"
                class="w-full h-40 object-cover"
              />
              <div class="p-2.5 bg-neutral-950 text-xs flex justify-between items-center">
                <span class="text-amber-400 font-bold">{intlExhibition.featuredWinners?.[0]?.award}</span>
                <span class="text-neutral-400 truncate ml-2">{intlExhibition.featuredWinners?.[0]?.photographer}</span>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-neutral-800/80 flex items-center justify-between">
            <a
              href={intlExhibition.cataloguePdf}
              target="_blank"
              class="text-xs font-bold text-neutral-300 hover:text-amber-400 transition-colors flex items-center gap-1"
            >
              📥 Catalogue PDF
            </a>
            <a
              href="/exhibitions"
              class="text-xs font-bold text-amber-400 hover:text-amber-300"
            >
              See All &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. Distinctions Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-br from-neutral-900 via-neutral-900 to-neutral-950 border border-neutral-800 p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Artistic Honors</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Apply for FIAP & NPAS Distinctions</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
            All Sri Lankan photographers apply for FIAP honors (AFIAP, EFIAP, MFIAP) through NPAS. Online applications are now open for LNPAS, ANPAS, and FNPAS.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 flex-shrink-0">
          <a
            href="/distinctions"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            Apply for Distinctions &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
