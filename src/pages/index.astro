<!-- Client-side script for slow smooth cross-fade of winning photographs -->
<script define:vars={{ heroSlides }}>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const titleEl = document.getElementById('slide-title');
  const authorEl = document.getElementById('slide-author');
  const counterEl = document.getElementById('slide-counter');

  function updateSlide(nextIndex) {
    if (!slides.length) return;
    
    // Fade out current slide
    slides[currentIndex]?.classList.remove('opacity-100');
    slides[currentIndex]?.classList.add('opacity-0');

    // Fade in next slide
    slides[nextIndex]?.classList.remove('opacity-0');
    slides[nextIndex]?.classList.add('opacity-100');

    // Update floating subtle badge with small clean text
    const data = heroSlides[nextIndex];
    if (data) {
      if (titleEl) titleEl.textContent = `"${data.title}"`;
      if (authorEl) authorEl.textContent = `— ${data.photographer} (${data.country})`;
      if (counterEl) counterEl.textContent = `${nextIndex + 1}/${heroSlides.length}`;
    }

    currentIndex = nextIndex;
  }

  // Slowly change every 6 seconds with smooth 1000ms transition
  setInterval(() => {
    const next = (currentIndex + 1) % heroSlides.length;
    updateSlide(next);
  }, 6000);
</script>
