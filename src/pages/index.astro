---
import BaseLayout from '../layouts/BaseLayout.astro';
import { exhibitionsData } from '../data/exhibitions';

const latestExhibition = exhibitionsData[0];
const intlExhibition = exhibitionsData[1];

// Curated master photographs that rotate smoothly in the hero background
const heroSlides = [
  {
    image: "/assets/images/exhibitions/NPAS-Gold-Medal-elmas-Cumcu-Turkiye-isolation-1-scaled.jpg",
    title: "Isolation",
    photographer: "Elmas Cumcu",
    country: "Türkiye",
    award: "NPAS Gold Medal • 21st International Salon"
  },
  {
    image: "/assets/images/exhibitions/FIAP-Silver-Medal-WASIRI-GAJAMAN-Sri-Lanka-BATTLE-1-scaled.jpg",
    title: "Battle",
    photographer: "Dr. Wasiri Gajaman",
    country: "Sri Lanka",
    award: "FIAP Silver Medal • 46th National Competition"
  },
  {
    image: "/assets/images/exhibitions/NPAS-Gold-Medal-Erdem-Arif-Yigit-Turkiye-gokhan_usta_2742-1-scaled.jpg",
    title: "Gokhan Usta",
    photographer: "Erdem Arif Yigit",
    country: "Türkiye",
    award: "NPAS Gold Medal • 21st International Salon"
  },
  {
    image: "/assets/images/exhibitions/NPAS-Silver-Medal-Pandula-Bandara-Sri-Lanka-Check-Mate-1-scaled.jpg",
    title: "Check Mate",
    photographer: "Pandula Bandara",
    country: "Sri Lanka",
    award: "NPAS Silver Medal • 46th National Competition"
  },
  {
    image: "/assets/images/hero/new_home_hero_banner.jpg",
    title: "Master Collection",
    photographer: "Henry Rajakaruna & Fellows",
    country: "Sri Lanka",
    award: "NPAS Permanent Collection"
  }
];
---

<BaseLayout title="Home - The National Photographic Art Society of Sri Lanka">
  
  <!-- Hero Section with Smooth Cross-fading Winning Photography Slideshow -->
  <section id="hero-slider" class="relative bg-neutral-950 overflow-hidden border-b border-neutral-800 min-h-[640px] sm:min-h-[700px] flex items-center">
    
    <!-- Background Slides with Smooth Opacity Cross-fade -->
    <div class="absolute inset-0 z-0">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
          data-slide-index={index}
        >
          <img
            src={slide.image}
            alt={`${slide.title} by ${slide.photographer}`}
            class="w-full h-full object-cover object-center transform scale-102"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/75 to-neutral-950/40"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/70 to-transparent"></div>
        </div>
      ))}
    </div>

    <!-- Main Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 w-full">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-12">
        
        <!-- Left: Headings and Action buttons -->
        <div class="max-w-3xl space-y-7">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Established 1950 • Operational Member of FIAP
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12]">
            Inspiring the Art of <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">Photography</span> in Sri Lanka
          </h1>

          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 leading-relaxed font-light max-w-2xl">
            The National Photographic Art Society of Sri Lanka is the nation's premier body fostering photographic mastery, professional distinctions, diplomas, and international exhibitions for over seven decades.
          </p>

          <!-- Buttons ordered: Membership > Education > Exhibitions > Distinctions -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
            <a
              href="/membership"
              class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs sm:text-sm tracking-wide transition-all shadow-lg shadow-amber-500/20 hover:shadow-amber-500/30 flex items-center gap-2"
            >
              Become a Member
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a
              href="/education"
              class="px-6 py-3.5 rounded-xl bg-neutral-900/90 hover:bg-neutral-800 text-neutral-100 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 hover:border-neutral-500 transition-all backdrop-blur-md"
            >
              Diploma Courses
            </a>
            <a
              href="/exhibitions"
              class="px-6 py-3.5 rounded-xl bg-neutral-900/90 hover:bg-neutral-800 text-amber-400 font-semibold text-xs sm:text-sm tracking-wide border border-neutral-700 transition-all backdrop-blur-md"
            >
              Exhibitions & Salons
            </a>
            <a
              href="/distinctions"
              class="px-5 py-3.5 rounded-xl bg-transparent hover:bg-neutral-900/60 text-neutral-300 hover:text-amber-400 font-semibold text-xs sm:text-sm tracking-wide transition-all"
            >
              Distinctions &rarr;
            </a>
          </div>
        </div>

        <!-- Right: Floating Semi-Transparent Artwork Info Card (Dynamic to active slide) -->
        <div class="flex-shrink-0 lg:max-w-sm">
          <div class="p-4 sm:p-5 rounded-2xl bg-neutral-950/75 backdrop-blur-md border border-neutral-800/90 shadow-2xl space-y-2">
            <div class="flex items-center justify-between text-[11px] text-amber-400 font-bold tracking-wider uppercase">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                Featured Masterpiece
              </span>
              <span id="slide-counter" class="text-neutral-500 font-mono text-[10px]">1 / {heroSlides.length}</span>
            </div>
            
            <div>
              <h2 id="slide-title" class="text-sm sm:text-base font-bold text-white tracking-wide">
                "{heroSlides[0].title}"
              </h2>
              <p id="slide-author" class="text-xs text-neutral-300 mt-0.5 font-medium">
                Photographer: {heroSlides[0].photographer} ({heroSlides[0].country})
              </p>
            </div>

            <p id="slide-award" class="text-[11px] text-amber-400/90 font-medium pt-1.5 border-t border-neutral-800/80">
              {heroSlides[0].award}
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Key Pillars / Feature Cards (Clean, Professional, Architectural Aesthetic - No cartoon icons) -->
  <section class="py-16 sm:py-24 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Key Pillars</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
          Dedicated to Photographic Excellence
        </h2>
        <p class="text-xs sm:text-sm text-neutral-400">
          The four cornerstone foundations of the National Photographic Art Society of Sri Lanka.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <!-- Pillar 01: Membership -->
        <div class="p-8 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/50 transition-all hover:-translate-y-1 group flex flex-col justify-between shadow-xl">
          <div class="space-y-6">
            <!-- Modern Minimal Badge & Professional SVG Icon -->
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400 tracking-wider">01</span>
              <div class="w-10 h-10 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Membership
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-light">
                Join a respected national fraternity with access to masterclasses, monthly competitions, voting rights, and permanent Life Membership status.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800/80 mt-6">
            <a href="/membership" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5">
              Join Fraternity <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 02: Education -->
        <div class="p-8 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/50 transition-all hover:-translate-y-1 group flex flex-col justify-between shadow-xl">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400 tracking-wider">02</span>
              <div class="w-10 h-10 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Education
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-light">
                Esteemed academic Diploma in Photography and free island-wide school photography examinations fostering the next generation of visual artists.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800/80 mt-6">
            <a href="/education" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5">
              Explore Courses <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 03: Exhibitions -->
        <div class="p-8 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/50 transition-all hover:-translate-y-1 group flex flex-col justify-between shadow-xl">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400 tracking-wider">03</span>
              <div class="w-10 h-10 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Exhibitions
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-light">
                Annual National Exhibitions and FIAP Patronage International Salons recognizing world-class creations with medals, ribbons, and printed catalogues.
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800/80 mt-6">
            <a href="/exhibitions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5">
              View Salons & Results <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 04: Distinctions -->
        <div class="p-8 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/50 transition-all hover:-translate-y-1 group flex flex-col justify-between shadow-xl">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400 tracking-wider">04</span>
              <div class="w-10 h-10 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-amber-400 group-hover:border-amber-500/40 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </div>
            </div>

            <div class="space-y-2.5">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                Distinctions
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-light">
                Apply online for prestigious national NPAS distinctions (LNPAS, ANPAS, FNPAS) and global FIAP Honors (AFIAP, EFIAP, MFIAP).
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-neutral-800/80 mt-6">
            <a href="/distinctions" class="text-xs font-bold text-amber-400 hover:text-amber-300 tracking-wider uppercase inline-flex items-center gap-1.5">
              Apply For Distinctions <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 1. Membership Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-900/30 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-neutral-900 border border-neutral-800 p-8 sm:p-12 flex flex-col lg:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-4 max-w-2xl">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Fraternity</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Your Pride of Life — For Life</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            Whether taking your first steps or seeking permanent Life Membership, NPAS offers unmatched fraternity support, monthly internal contests, and salon fee concessions.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 flex-shrink-0">
          <a
            href="/membership"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            Apply For Membership &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Education Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-950 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="space-y-4">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Academic Studies</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Comprehensive Diploma in Photography</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            Providing high-caliber photographic training from optics and studio lighting to advanced digital darkroom techniques. Guided by the Director of Education and veteran faculty.
          </p>
          <div class="pt-2 flex gap-4">
            <a
              href="/education"
              class="px-5 py-3 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white font-semibold text-xs transition-colors border border-neutral-700"
            >
              Explore Course Details &rarr;
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-neutral-800 shadow-xl max-h-72">
          <img
            src="/assets/images/education/edu-dip.jpg"
            alt="Diploma in Photography"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Exhibitions & Awards Showcase -->
  <section class="py-16 sm:py-20 bg-neutral-900/30 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Competitions & Salons</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Exhibitions & Medal Winners</h2>
        </div>
        <a href="/exhibitions" class="inline-flex items-center text-xs sm:text-sm font-semibold text-amber-400 hover:text-amber-300">
          All Exhibitions & Guidelines &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Big Card: 46th National Exhibition -->
        <div class="lg:col-span-2 rounded-2xl bg-neutral-900 border border-neutral-800 overflow-hidden flex flex-col md:flex-row shadow-xl">
          <div class="md:w-1/2 relative min-h-[260px]">
            <img
              src={latestExhibition.coverImage}
              alt={latestExhibition.title}
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="md:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center gap-2">
                <span class="inline-block px-2.5 py-1 rounded bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider">
                  {latestExhibition.type}
                </span>
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider border border-emerald-500/30">
                  Results Published
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
                {latestExhibition.title}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-light">
                {latestExhibition.description}
              </p>
            </div>
            
            <div class="pt-6 space-y-3">
              <div class="flex flex-wrap gap-2.5">
                <a
                  href={latestExhibition.resultsPdf}
                  target="_blank"
                  class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-xs font-bold text-white transition-colors flex items-center gap-1.5"
                >
                  🏆 View Results (PDF)
                </a>
                <a
                  href={latestExhibition.guidelinesEnglishPdf}
                  target="_blank"
                  class="px-3.5 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-xs font-semibold text-neutral-200 transition-colors"
                >
                  📄 Guidelines
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 21st International Salon Card -->
        <div class="rounded-2xl bg-neutral-900 border border-neutral-800 overflow-hidden flex flex-col justify-between p-6 sm:p-8 shadow-xl">
          <div class="space-y-4">
            <span class="inline-block px-2.5 py-1 rounded bg-sky-500/20 text-sky-400 text-xs font-bold uppercase tracking-wider">
              {intlExhibition.type} Salon
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
              {intlExhibition.title}
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed font-light">
              {intlExhibition.description}
            </p>
            <div class="rounded-xl overflow-hidden border border-neutral-800 my-2">
              <img
                src={intlExhibition.featuredWinners?.[0]?.image}
                alt="Award Winner"
                class="w-full h-40 object-cover"
              />
              <div class="p-2.5 bg-neutral-950 text-xs flex justify-between items-center">
                <span class="text-amber-400 font-bold">{intlExhibition.featuredWinners?.[0]?.award}</span>
                <span class="text-neutral-400 truncate ml-2">{intlExhibition.featuredWinners?.[0]?.photographer}</span>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-neutral-800/80 flex items-center justify-between">
            <a
              href={intlExhibition.cataloguePdf}
              target="_blank"
              class="text-xs font-bold text-neutral-300 hover:text-amber-400 transition-colors flex items-center gap-1"
            >
              📥 Catalogue PDF
            </a>
            <a
              href="/exhibitions"
              class="text-xs font-bold text-amber-400 hover:text-amber-300"
            >
              See All &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. Distinctions Spotlight Area -->
  <section class="py-16 sm:py-20 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-br from-neutral-900 via-neutral-900 to-neutral-950 border border-neutral-800 p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Artistic Honors</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Apply for FIAP & NPAS Distinctions</h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
            All Sri Lankan photographers apply for FIAP honors (AFIAP, EFIAP, MFIAP) through NPAS. Online applications are now open for LNPAS, ANPAS, and FNPAS.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 flex-shrink-0">
          <a
            href="/distinctions"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            Apply for Distinctions &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Client-side script for slow smooth cross-fade of winning photographs -->
<script define:vars={{ heroSlides }}>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const titleEl = document.getElementById('slide-title');
  const authorEl = document.getElementById('slide-author');
  const awardEl = document.getElementById('slide-award');
  const counterEl = document.getElementById('slide-counter');

  function updateSlide(nextIndex) {
    if (!slides.length) return;
    
    // Fade out current slide
    slides[currentIndex]?.classList.remove('opacity-100');
    slides[currentIndex]?.classList.add('opacity-0');

    // Fade in next slide
    slides[nextIndex]?.classList.remove('opacity-0');
    slides[nextIndex]?.classList.add('opacity-100');

    // Update floating info card with small text
    const data = heroSlides[nextIndex];
    if (data) {
      if (titleEl) titleEl.textContent = `"${data.title}"`;
      if (authorEl) authorEl.textContent = `Photographer: ${data.photographer} (${data.country})`;
      if (awardEl) awardEl.textContent = data.award;
      if (counterEl) counterEl.textContent = `${nextIndex + 1} / ${heroSlides.length}`;
    }

    currentIndex = nextIndex;
  }

  // Slowly change every 6 seconds with smooth 1000ms transition
  setInterval(() => {
    const next = (currentIndex + 1) % heroSlides.length;
    updateSlide(next);
  }, 6000);
</script>
