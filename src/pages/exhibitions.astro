---
import BaseLayout from '../layouts/BaseLayout.astro';
import { exhibitionsData } from '../data/exhibitions';
---

<BaseLayout 
  title="Exhibitions & Salons"
  description="Explore the National and International Photographic Exhibitions organized by NPAS Sri Lanka. Download guidelines, catalogues, and view medal winners."
>
  <!-- Page Header -->
  <section class="bg-neutral-900/60 border-b border-neutral-800 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">NPAS Salons & Competitions</span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">National & International Exhibitions</h1>
      <p class="max-w-2xl mx-auto text-neutral-400 text-sm sm:text-base leading-relaxed px-4">
        Showcasing master photography, recognizing artistic talent with FIAP & NPAS medals, and publishing international catalogues.
      </p>
    </div>
  </section>

  <!-- Exhibitions List -->
  <section class="py-16 sm:py-24 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 sm:space-y-24">
      
      {exhibitionsData.map((exhibition, index) => (
        <div class="space-y-12">
          
          <!-- Exhibition Header Card -->
          <div class="rounded-3xl bg-neutral-900 border border-neutral-800 overflow-hidden flex flex-col lg:flex-row shadow-2xl">
            {exhibition.coverImage && (
              <div class="lg:w-2/5 relative min-h-[300px] sm:min-h-[380px] bg-neutral-950">
                <img
                  src={exhibition.coverImage}
                  alt={exhibition.title}
                  class="w-full h-full object-cover object-center"
                />
              </div>
            )}
            
            <div class={`p-6 sm:p-10 lg:p-12 flex flex-col justify-between ${exhibition.coverImage ? 'lg:w-3/5' : 'w-full'}`}>
              <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                  <span class="px-3 py-1 rounded bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider">
                    {exhibition.type} Exhibition
                  </span>
                  <span class="text-xs font-semibold text-neutral-500">
                    Year: {exhibition.year}
                  </span>
                  <span class="px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 border border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    {exhibition.resultsStatus}
                  </span>
                </div>

                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
                  {exhibition.title}
                </h2>

                <p class="text-neutral-300 text-sm sm:text-base leading-relaxed font-light">
                  {exhibition.description}
                </p>
              </div>

              <!-- Action Links / Downloads -->
              <div class="pt-8 space-y-4 border-t border-neutral-800 mt-8">
                <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 block">
                  Official Downloads & Documents
                </span>
                
                <div class="flex flex-wrap gap-3">
                  {exhibition.guidelinesEnglishPdf && (
                    <a
                      href={exhibition.guidelinesEnglishPdf}
                      target="_blank"
                      class="px-4 py-2.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-semibold flex items-center gap-2 border border-neutral-700 hover:border-amber-500/50 transition-all shadow-sm"
                    >
                      <span>📥</span> Guidelines (English PDF)
                    </a>
                  )}

                  {exhibition.guidelinesSinhalaPdf && (
                    <a
                      href={exhibition.guidelinesSinhalaPdf}
                      target="_blank"
                      class="px-4 py-2.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-semibold flex items-center gap-2 border border-neutral-700 hover:border-amber-500/50 transition-all shadow-sm"
                    >
                      <span>📥</span> Guidelines (Sinhala PDF)
                    </a>
                  )}

                  {exhibition.resultsPdf && (
                    <a
                      href={exhibition.resultsPdf}
                      target="_blank"
                      class="px-4 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center gap-2 transition-all shadow-md"
                    >
                      <span>🏆</span> View Results & Award List (PDF)
                    </a>
                  )}

                  {exhibition.cataloguePdf && (
                    <a
                      href={exhibition.cataloguePdf}
                      target="_blank"
                      class="px-4 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-bold flex items-center gap-2 transition-all shadow-md"
                    >
                      <span>📖</span> Download Catalogue (PDF)
                    </a>
                  )}
                </div>
              </div>

            </div>
          </div>

          <!-- Featured Winners Gallery (if available) -->
          {exhibition.featuredWinners && exhibition.featuredWinners.length > 0 && (
            <div class="space-y-6">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-3">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                  <span class="text-amber-400">🏅</span> Award-Winning Photographic Masterpieces
                </h3>
                <span class="text-xs text-neutral-400">
                  {exhibition.featuredWinners.length} Featured Medals
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {exhibition.featuredWinners.map((winner) => (
                  <div class="group rounded-2xl bg-neutral-900 border border-neutral-800 overflow-hidden hover:border-amber-500/40 transition-all hover:-translate-y-1 shadow-lg">
                    <div class="h-60 overflow-hidden bg-neutral-950 relative">
                      <img
                        src={winner.image}
                        alt={`${winner.title} by ${winner.photographer}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                      <div class="absolute top-3 left-3 px-2.5 py-1 rounded bg-neutral-950/80 backdrop-blur-md text-amber-400 text-[11px] font-bold border border-neutral-800">
                        {winner.award}
                      </div>
                    </div>
                    
                    <div class="p-5 space-y-1.5">
                      <h4 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors">
                        "{winner.title}"
                      </h4>
                      <p class="text-xs font-medium text-neutral-300">
                        {winner.photographer}
                      </p>
                      <p class="text-[11px] text-neutral-500">
                        {winner.country}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
      ))}

    </div>
  </section>

  <!-- Submission Inquiry Card -->
  <section class="py-16 bg-neutral-900/30 border-t border-neutral-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">
      <h3 class="text-2xl font-bold text-white">Have Questions About Entering Our Next Exhibition?</h3>
      <p class="text-sm text-neutral-400">
        Reach out to our Exhibition Directorate for competition queries, salon patronages, or entry assistance.
      </p>
      <div class="pt-2">
        <a
          href="mailto:chamara.sa@gmail.com"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all"
        >
          Contact Director Exhibitions &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
