---
import BaseLayout from '../layouts/BaseLayout.astro';
import { boardOfDirectors } from '../data/board';
---

<BaseLayout 
  title="Contact Us"
  description="Contact the National Photographic Art Society of Sri Lanka. 82C, Sri Sudarshanarama Road, Kiribathgoda. 11600, Sri Lanka."
>
  <!-- Page Header -->
  <section class="bg-neutral-900/60 border-b border-neutral-800 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Get In Touch</span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">Contact The Secretariat</h1>
      <p class="max-w-2xl mx-auto text-neutral-400 text-sm sm:text-base leading-relaxed px-4">
        We welcome inquiries from photographers, educational institutions, international salons, and the general public.
      </p>
    </div>
  </section>

  <!-- Contact Information & Map -->
  <section class="py-16 sm:py-24 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <!-- Details & Directory -->
        <div class="space-y-8">
          
          <div class="p-8 rounded-3xl bg-neutral-900 border border-neutral-800 space-y-6 shadow-xl">
            <h2 class="text-2xl font-bold text-white flex items-center gap-3">
              <span class="text-amber-400">📍</span> Head Office & Secretariat
            </h2>
            <div class="text-sm text-neutral-300 space-y-3 leading-relaxed">
              <p>
                <strong>The National Photographic Art Society of Sri Lanka</strong><br/>
                82C, Sri Sudarshanarama Road,<br/>
                Kiribathgoda. 11600, Sri Lanka.
              </p>
              <div class="pt-2 space-y-1.5 text-xs text-neutral-400">
                <p><strong>General Inquiry Emails:</strong></p>
                <p>✉️ <a href="mailto:npas@sltnet.lk" class="text-amber-400 hover:underline">npas@sltnet.lk</a></p>
                <p>✉️ <a href="mailto:npassrilanka@gmail.com" class="text-amber-400 hover:underline">npassrilanka@gmail.com</a></p>
                <p>✉️ <a href="mailto:npas.fiap.acct@gmail.com" class="text-amber-400 hover:underline">npas.fiap.acct@gmail.com</a></p>
              </div>
            </div>
          </div>

          <!-- Quick Directory for Specific Matters -->
          <div class="p-8 rounded-3xl bg-neutral-900 border border-neutral-800 space-y-4 shadow-xl">
            <h3 class="text-lg font-bold text-white">Direct Contact by Portfolio</h3>
            
            <div class="space-y-3 text-xs text-neutral-300 divide-y divide-neutral-800">
              <div class="pt-2 flex justify-between items-center">
                <div>
                  <strong class="text-white">Exhibitions & Salons:</strong>
                  <p class="text-neutral-400">Chamara Ranathunga (Director)</p>
                </div>
                <a href="mailto:chamara.sa@gmail.com" class="text-amber-400 hover:underline">+94 771 739 354</a>
              </div>

              <div class="pt-2 flex justify-between items-center">
                <div>
                  <strong class="text-white">Registrar & Membership:</strong>
                  <p class="text-neutral-400">Saliya Liyanage (Director)</p>
                </div>
                <a href="mailto:Saliyaliyanage79@gmail.com" class="text-amber-400 hover:underline">+94 713 963 030</a>
              </div>

              <div class="pt-2 flex justify-between items-center">
                <div>
                  <strong class="text-white">Education & Diploma:</strong>
                  <p class="text-neutral-400">Sisira Kumara (Director)</p>
                </div>
                <a href="mailto:sisira.ts@gmail.com" class="text-amber-400 hover:underline">+94 717 189 038</a>
              </div>

              <div class="pt-2 flex justify-between items-center">
                <div>
                  <strong class="text-white">President & FIAP Matters:</strong>
                  <p class="text-neutral-400">Sanka Sammana (President)</p>
                </div>
                <a href="mailto:sankasammana@gmail.com" class="text-amber-400 hover:underline">+94 77 776 8015</a>
              </div>
            </div>
          </div>

        </div>

        <!-- Embedded Map with Kiribathgoda Location -->
        <div class="rounded-3xl overflow-hidden border border-neutral-800 bg-neutral-900 shadow-xl min-h-[400px]">
          <iframe
            src="https://maps.google.com/maps?q=82C%2C%20Sri%20Sudarshanarama%20Road%2C%20Kiribathgoda&t=m&z=16&output=embed&iwloc=near"
            width="100%"
            height="100%"
            style="border:0; min-height: 480px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="NPAS Kiribathgoda Location"
          ></iframe>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
